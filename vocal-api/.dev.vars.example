# Copy to .dev.vars for `wrangler pages dev`. Do NOT commit.
# .gitignore'd via the top-level .gitignore (.env, .dev.vars).

# --- LLM providers (any one works; pool rotates across all configured) ---
WAFER_API_KEY=wfr_xxx
OPENROUTER_API_KEY=sk-or-v1-xxx
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Comma-separated bulk seeding (alternative to numbered _API_KEY_2/_3/...)
WAFER_API_KEYS=
GEMINI_API_KEYS=

# --- Auth (required for /api/auth/* in production-like setups) ---
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=
# At least one Google client ID required for /api/auth/google to issue tokens.
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=
# REQUIRED for /api/auth/apple — the iOS bundle ID that signs in with Apple.
# Apple's identity_token's `aud` claim must equal this; without it we'd
# accept any Apple-issued token for any app, which is a critical bypass.
APPLE_BUNDLE_ID=
# Optional CSV of additional accepted audiences (e.g. a Services ID for
# Sign in with Apple JS on the web).
APPLE_AUDIENCES=

# --- Other ---
USDA_FDC_API_KEY=

# --- ElevenLabs TTS (for /api/coach/voice) ---
# Comma-separated list of API keys; the endpoint rotates on 401/402/429/5xx.
# Single-key dev setups can also set ELEVENLABS_API_KEY.
ELEVENLABS_API_KEYS=
ELEVENLABS_API_KEY=
# Optional voice ID override (defaults to "pNInz6obpgDQGcFmaJgB" — Adam).
ELEVENLABS_VOICE_ID=
