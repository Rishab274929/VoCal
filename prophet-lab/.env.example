# Copy to .env and fill in.

# Required: at least ONE LLM provider key (default config uses Wafer).
# Wafer Pass — flat-rate access to fast open-source models (GLM-5.1, Qwen3.5, …)
# Sign up at https://wafer.ai/api-key
WAFER_API_KEY=wfr_...

# Optional: OpenRouter — multi-provider gateway (Claude, GPT, Gemini, Llama, …)
# Sign up at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: native OpenAI / Anthropic, if you want to call them directly.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Required for the trade track. Issued by Prophet Arena out of band.
PA_SERVER_API_KEY=prophet_...
PA_SERVER_URL=https://api.aiprophet.dev

# Optional web research backend. Pick one (or leave both unset to disable research).
BRAVE_API_KEY=
TAVILY_API_KEY=

# Optional: locks the bearer token on the hosted /chat/completions endpoint.
SIGMA_BEARER_TOKEN=

# Optional: override the experiment slug at runtime.
PROPHET_SLUG=sigma-prophet
