<?xml version="1.0" encoding="utf-8"?>
<!--
  Rounded-corner ink surface matching the app's Palette.inkSurface.
  Stays compatible with Android 12+ widget rounded corners (the system
  also clips to MaterialYou radii on launcher-managed previews).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF18181C" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#FF2E2D29" />
</shape>
