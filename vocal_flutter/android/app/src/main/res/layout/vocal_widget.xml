<?xml version="1.0" encoding="utf-8"?>
<!--
  Single layout that adapts to both small and medium widget sizes via
  match_parent + LinearLayout flex. RemoteViews can't use ConstraintLayout
  or modern Compose, so this is the cleanest "scales sensibly" shape.
  Editorial palette: ink background, paper text, no chroma.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <!-- Headline: hero kcal-remaining number. Newsreader serif on iOS;
         we use the system serif here since RemoteViews can't pull a
         custom font without an FT2 raster atlas (more trouble than it's
         worth for a 2x2 tile). -->
    <TextView
        android:id="@+id/widget_kcal_remaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="32sp"
        android:textStyle="normal"
        android:textColor="#FFFFFFFF"
        android:fontFamily="serif"
        android:textFontWeight="500"
        android:text="0" />

    <TextView
        android:id="@+id/widget_kcal_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:letterSpacing="0.15"
        android:textColor="#FF86847B"
        android:text="kcal left" />

    <ProgressBar
        android:id="@+id/widget_kcal_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#FFFFFFFF"
        android:progressBackgroundTint="#FF2E2D29" />

    <TextView
        android:id="@+id/widget_kcal_breakdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:textColor="#FF86847B"
        android:text="0 / 2,000" />

    <!-- Protein row — hidden in the smallest cell because we don't have
         vertical headroom, shown when the widget gets resized larger.
         RemoteViews doesn't support layout queries, so we just keep it
         visible at all sizes and rely on Android collapsing it gracefully
         when the cell is below ~110dp tall. -->
    <TextView
        android:id="@+id/widget_protein"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textColor="#FFF5F2EA"
        android:text="P 0g / 140g" />

    <ProgressBar
        android:id="@+id/widget_protein_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#FFF5F2EA"
        android:progressBackgroundTint="#FF1F1E1B" />
</LinearLayout>
